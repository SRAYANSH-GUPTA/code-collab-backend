PORT=8080
ENV=development

LOKI_URL=http://loki:3100

SUPABASE_URL=
SUPABASE_ANON_KEY=

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

LAMBDA_ARN_TYPESCRIPT=
LAMBDA_ARN_PYTHON=
LAMBDA_ARN_DART=
LAMBDA_ARN_GO=
LAMBDA_ARN_CPP=

USE_MOCK_LAMBDA=false
USE_MOCK_AUTH=false

# ===================================
# Voice Call Configuration (WebRTC)
# ===================================

# STUN Servers (comma-separated, defaults to Google's free STUN servers if not specified)
# STUN helps peers discover their public IP addresses for NAT traversal
# Default: stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302
STUN_SERVERS=

# TURN Servers (comma-separated, optional but recommended for production)
# TURN servers relay media when direct P2P connection fails (restrictive NATs/firewalls)
# Format: turn:hostname:port
# Example: TURN_SERVERS=turn:turn.example.com:3478,turn:turn2.example.com:3478
TURN_SERVERS=

# TURN Server Credentials (required if TURN_SERVERS is set)
TURN_USERNAME=
TURN_PASSWORD=

# Public IP of EC2 instance (REQUIRED for AWS - without this, ICE candidates use private IP)
PUBLIC_IP=

# UDP port range for WebRTC media (must match AWS security group rules)
UDP_MIN_PORT=50000
UDP_MAX_PORT=50100
